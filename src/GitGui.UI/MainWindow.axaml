<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGui.UI" xmlns:core="using:GitGui.Core"
        x:Class="GitGui.UI.MainWindow" x:DataType="vm:MainWindowViewModel"
        Width="1480" Height="940" MinWidth="1100" MinHeight="700"
        Title="GITGUI" Icon="avares://GitGui.UI/Assets/gitgui.ico" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}" FontSize="13" FontFamily="Segoe UI,Inter,Microsoft JhengHei,PingFang TC,Noto Sans TC,sans-serif">
  <Window.Styles>
    <StyleInclude Source="avares://GitGui.UI/AppearanceStyles.axaml"/>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <Style Selector="TextBlock.section"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="LetterSpacing" Value="0.7"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,10"/></Style>
    <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="420"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12" RowSpacing="10">
    <Grid ColumnDefinitions="156,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="4,2,4,2">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="avares://GitGui.UI/Assets/gitgui.png" Width="34" Height="34"/><StackPanel><TextBlock Text="GITGUI" FontWeight="SemiBold" FontSize="20" LetterSpacing="1"/><TextBlock Text="{Binding L[WorkspaceSubtitle]}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
      <TextBox Grid.Column="1" Name="RepositoryPathInput" AutomationProperties.Name="{Binding L[RepositoryPath]}" Text="{Binding RepositoryPath}" Watermark="{Binding L[RepositoryPath]}" VerticalAlignment="Center" ToolTip.Tip="{Binding RepositoryPath}"/>
      <vm:ActionButton Icon="Folder" Grid.Column="2" Content="{Binding L[Browse]}" Click="BrowseClick" VerticalAlignment="Center"/>
      <vm:ActionButton Icon="Open" Grid.Column="3" Name="OpenRepositoryButton" Content="{Binding L[Open]}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
      <vm:ActionButton Icon="Repository" Grid.Column="4" Content="{Binding L[RepositoryActions]}" Click="RepositoryActionsClick" VerticalAlignment="Center"/>
      <vm:ActionButton Icon="Settings" Grid.Column="5" Name="GitSettingsButton" Content="{Binding L[GitSettings]}" Click="GitSettingsClick" IsEnabled="{Binding CanConfigure}" VerticalAlignment="Center"/>
      <vm:ActionButton Grid.Column="6" Name="AppearanceButton" Icon="Palette" Content="{Binding L[Appearance]}" Click="AppearanceClick" VerticalAlignment="Center"/>
      <CheckBox Grid.Column="7" Content="EN" IsChecked="{Binding English}" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>
    <Border Grid.Row="1" Classes="panel" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="7">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><vm:ActionIcon Kind="Branch" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Branch}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Tracking}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
        <TextBox Grid.Column="1" AutomationProperties.Name="{Binding L[Remote]}" Text="{Binding RemoteName}" Width="100" Watermark="{Binding L[Remote]}" ToolTip.Tip="{Binding L[Remote]}"/>
        <vm:ActionButton Icon="Fetch" Grid.Column="2" Content="{Binding L[Fetch]}" Command="{Binding ActionCommand}" CommandParameter="Fetch" IsEnabled="{Binding CanOperate}"/>
        <vm:ActionButton Icon="Pull" Grid.Column="3" Content="{Binding L[Pull]}" Command="{Binding ActionCommand}" CommandParameter="Pull" IsEnabled="{Binding CanOperate}"/>
        <CheckBox Grid.Column="4" Content="{Binding L[ForcePush]}" IsChecked="{Binding ForcePush}" VerticalAlignment="Center" ToolTip.Tip="--force-with-lease --force-if-includes"/>
        <vm:ActionButton Icon="Push" Grid.Column="5" Content="{Binding L[Push]}" Command="{Binding ActionCommand}" CommandParameter="Push" IsEnabled="{Binding CanOperate}"/>
        <vm:ActionButton Icon="Undo" Margin="12,0,0,0" Grid.Column="6" Content="{Binding L[Undo]}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
        <vm:ActionButton Icon="Redo" Grid.Column="7" Content="{Binding L[Redo]}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
        <vm:ActionButton Icon="History" Grid.Column="8" Name="AdvancedButton" Content="{Binding L[AdvancedOpen]}" Click="AdvancedClick" IsEnabled="{Binding CanOperate}"/>
        <vm:ActionButton Icon="RepositoryTools" Grid.Column="9" Name="RepositoryToolsButton" Content="{Binding L[ToolsOpen]}" Click="RepositoryToolsClick" IsEnabled="{Binding CanOperate}"/>
        <vm:ActionButton Icon="Command" Grid.Column="10" Name="TerminalButton" Content="{Binding L[Terminal]}" Click="TerminalClick" IsEnabled="{Binding CanOperate}"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="224,6,*,6,1.05*" ColumnSpacing="6">
      <Border Classes="panel" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
          <TextBlock Classes="section" Text="{Binding L[Recent]}"/>
          <ListBox Grid.Row="1" Name="RecentList" ItemsSource="{Binding Recent}" SelectionChanged="RecentSelectionChanged" MaxHeight="118"><ListBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Grid.Row="2" Classes="section" Text="{Binding L[Branches]}"/>
          <ListBox Grid.Row="3" Name="RefsList" ItemsSource="{Binding Refs}" SelectedItem="{Binding SelectedRef}" DoubleTapped="BranchDoubleTapped"><ListBox.ItemTemplate><DataTemplate x:DataType="core:RefInfo"><StackPanel Margin="0,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding Tracking}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Expander Grid.Row="4" Header="{Binding L[BranchActions]}" IsExpanded="True">
            <StackPanel Spacing="7" Margin="0,8,0,0">
              <TextBlock Text="{Binding L[BranchName]}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBox AutomationProperties.Name="{Binding L[BranchName]}" Text="{Binding BranchName}"/>
              <UniformGrid Columns="2" Rows="1"><vm:ActionButton Icon="Plus" Content="{Binding L[CreateShort]}" ToolTip.Tip="{Binding L[CreateBranch]}" Command="{Binding ActionCommand}" CommandParameter="CreateBranch" IsEnabled="{Binding CanOperate}" Margin="0,0,4,0"/><vm:ActionButton Icon="Switch" Content="{Binding L[SwitchShort]}" ToolTip.Tip="{Binding L[SwitchBranch]}" Command="{Binding ActionCommand}" CommandParameter="SwitchBranch" IsEnabled="{Binding CanOperate}"/></UniformGrid>
              <vm:ActionButton Icon="Merge" Content="{Binding L[Merge]}" Command="{Binding ActionCommand}" CommandParameter="Merge" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch"/>
              <TextBlock Text="{Binding L[NewBranchName]}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBox AutomationProperties.Name="{Binding L[NewBranchName]}" Text="{Binding NewBranchName}"/>
              <vm:ActionButton Icon="Rename" Content="{Binding L[RenameBranch]}" Command="{Binding ActionCommand}" CommandParameter="RenameBranch" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch"/>
              <CheckBox Content="{Binding L[ForceDelete]}" IsChecked="{Binding ForceDelete}"/>
              <vm:ActionButton Icon="Trash" Classes="danger" Content="{Binding L[DeleteBranch]}" Command="{Binding ActionCommand}" CommandParameter="DeleteBranch" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Expander>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
      <Border Grid.Column="2" Classes="panel" Padding="8">
        <TabControl Name="WorkspaceTabs">
          <TabItem Header="{Binding L[WorkingTree]}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Margin="2,6,2,2">
              <Border IsVisible="{Binding IsUntrusted}" Background="{DynamicResource WarningSurfaceBrush}" Padding="10" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="{Binding L[Untrusted]}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12"/><TextBlock Text="{Binding TrustDetails}" TextWrapping="Wrap" FontSize="11"/><vm:ActionButton Icon="Shield" Content="{Binding L[Trust]}" Click="TrustClick"/></StackPanel></Border>
              <Border Grid.Row="1" IsVisible="{Binding InProgress}" Background="{DynamicResource ConflictSurfaceBrush}" Padding="10" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="{Binding InProgressText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding L[ResolveHint]}" TextWrapping="Wrap" FontSize="11"/><WrapPanel><vm:ActionButton Icon="Branch" Content="{Binding L[Ours]}" Command="{Binding ActionCommand}" CommandParameter="ResolveOurs" Margin="0,0,4,4"/><vm:ActionButton Icon="Branch" Content="{Binding L[Theirs]}" Command="{Binding ActionCommand}" CommandParameter="ResolveTheirs" Margin="0,0,4,4"/><vm:ActionButton Icon="Check" Content="{Binding L[MarkResolved]}" Command="{Binding ActionCommand}" CommandParameter="MarkResolved" Margin="0,0,4,4"/><vm:ActionButton Icon="Open" Content="{Binding L[MergeTool]}" Command="{Binding ActionCommand}" CommandParameter="ExternalMergeTool" Margin="0,0,4,4"/><vm:ActionButton Icon="Close" Classes="danger" Content="{Binding L[AbortMerge]}" Command="{Binding ActionCommand}" CommandParameter="AbortMerge" Margin="0,0,4,4"/></WrapPanel></StackPanel></Border>
              <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                <WrapPanel><vm:ActionButton Icon="Plus" Content="{Binding L[Stage]}" Command="{Binding ActionCommand}" CommandParameter="Stage" IsEnabled="{Binding CanOperate}" Margin="0,0,4,4"/><vm:ActionButton Icon="StageAll" Content="{Binding L[StageAll]}" Command="{Binding ActionCommand}" CommandParameter="StageAll" IsEnabled="{Binding CanOperate}" Margin="0,0,4,4"/><vm:ActionButton Icon="Minus" Content="{Binding L[Unstage]}" Command="{Binding ActionCommand}" CommandParameter="Unstage" IsEnabled="{Binding CanOperate}" Margin="0,0,4,4"/><vm:ActionButton Icon="UnstageAll" Content="{Binding L[UnstageAll]}" Command="{Binding ActionCommand}" CommandParameter="UnstageAll" IsEnabled="{Binding CanOperate}" Margin="0,0,4,4"/><vm:ActionButton Icon="Trash" Classes="danger" Content="{Binding L[Discard]}" Command="{Binding ActionCommand}" CommandParameter="Discard" IsEnabled="{Binding CanOperate}" Margin="0,0,4,4"/></WrapPanel>
                <TabControl Grid.Row="1" Name="ChangeTabs" SelectionChanged="ChangeTabSelectionChanged">
                  <TabItem Header="{Binding L[Unstaged]}"><ListBox Name="ChangesList" ItemsSource="{Binding UnstagedChanges}" SelectionMode="Multiple" SelectionChanged="ChangesSelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="core:FileChange"><Grid ColumnDefinitions="24,*" Margin="0,3"><TextBlock Text="{Binding WorktreeStatus}" Foreground="{DynamicResource WarningBrush}" FontFamily="Consolas,monospace"/><TextBlock Grid.Column="1" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayPath}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                  <TabItem Header="{Binding L[Staged]}"><ListBox Name="StagedChangesList" ItemsSource="{Binding StagedChanges}" SelectionMode="Multiple" SelectionChanged="ChangesSelectionChanged"><ListBox.ItemTemplate><DataTemplate x:DataType="core:FileChange"><Grid ColumnDefinitions="24,*" Margin="0,3"><TextBlock Text="{Binding IndexStatus}" Foreground="{DynamicResource SuccessBrush}" FontFamily="Consolas,monospace"/><TextBlock Grid.Column="1" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayPath}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                </TabControl>
              </Grid>
              <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,12,2,0"><StackPanel Spacing="7"><TextBlock Text="{Binding L[Message]}" Classes="section"/><TextBox Name="CommitMessageInput" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="{Binding L[Message]}" Text="{Binding CommitMessage}" AcceptsReturn="True" MinHeight="92" MaxHeight="150" Watermark="{Binding L[Message]}"/><WrapPanel><CheckBox Content="{Binding L[Amend]}" IsChecked="{Binding Amend}" Margin="0,0,12,0"/><CheckBox Content="{Binding L[SkipHooks]}" IsChecked="{Binding SkipHooks}" Margin="0,0,12,0"/><CheckBox Content="{Binding L[Sign]}" IsChecked="{Binding SignCommit}"/></WrapPanel><vm:ActionButton Icon="Commit" Name="CommitButton" MinHeight="38" Classes="primary" Content="{Binding L[Commit]}" Command="{Binding ActionCommand}" CommandParameter="Commit" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch"/><TextBlock Text="{Binding L[CommitHint]}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
            </Grid>
          </TabItem>
          <TabItem Header="{Binding L[History]}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="2,8,2,2">
              <StackPanel Spacing="6"><TextBox AutomationProperties.Name="{Binding L[Search]}" Text="{Binding Search}" Watermark="{Binding L[Search]}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="6"><TextBox AutomationProperties.Name="{Binding L[Author]}" Text="{Binding AuthorFilter}" Watermark="{Binding L[Author]}"/><TextBox Grid.Column="1" AutomationProperties.Name="{Binding L[Path]}" Text="{Binding PathFilter}" Watermark="{Binding L[Path]}"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="6"><TextBox AutomationProperties.Name="{Binding L[Since]}" Text="{Binding SinceFilter}" Watermark="{Binding L[Since]}"/><TextBox Grid.Column="1" AutomationProperties.Name="{Binding L[Until]}" Text="{Binding UntilFilter}" Watermark="{Binding L[Until]}"/></Grid><vm:ActionButton Icon="Search" Content="{Binding L[ApplyFilters]}" Command="{Binding SearchHistoryCommand}" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch"/></StackPanel>
              <ContentControl Grid.Row="1" Name="GraphHost"/>
              <vm:ActionButton Icon="More" Grid.Row="2" Content="{Binding L[LoadMore]}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Stretch"/>
            </Grid>
          </TabItem>
          <TabItem Header="{Binding L[Snapshots]}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Margin="2,8,2,2"><TextBlock Text="{Binding L[SnapshotHint]}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><ListBox Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"><ListBox.ItemTemplate><DataTemplate x:DataType="core:SnapshotInfo"><StackPanel Margin="0,6"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding CreatedAt}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Id}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><vm:ActionButton Icon="Undo" Grid.Row="2" Content="{Binding L[Restore]}" Command="{Binding ActionCommand}" CommandParameter="RestoreSnapshot" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch"/></Grid>
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent"/>
      <Border Grid.Column="4" Classes="panel" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock Text="{Binding DiffTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DiffTitle}" Margin="2,4"/>
          <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="{Binding RepositoryTextSettingsText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding SelectedEncodingText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding PreviewSummary}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding PreviewNotice}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><Border Height="3"><ProgressBar IsVisible="{Binding IsDiffLoading}" IsIndeterminate="{Binding IsDiffLoading}" Height="3"/></Border></StackPanel>
          <TabControl Grid.Row="2" Name="DetailTabs">
            <TabItem Header="{Binding L[Diff]}"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="8"><WrapPanel Margin="0,8,0,0"><CheckBox Content="{Binding L[ShowStaged]}" IsChecked="{Binding ShowStaged}" Margin="0,0,12,0"/><CheckBox Content="{Binding L[Split]}" IsChecked="{Binding SplitDiff}"/></WrapPanel><vm:ActionButton Icon="Open" Grid.Row="1" Content="{Binding L[LoadAnyway]}" IsVisible="{Binding IsLargeDiff}" Command="{Binding LoadLargeDiffCommand}"/><vm:DiffEditor Grid.Row="2" Name="DiffViewer" DocumentName="{Binding DiffTitle}" BeforeLabel="{Binding L[Before]}" AfterLabel="{Binding L[After]}" Source="{Binding Diff}" LeftSource="{Binding LeftDiff}" RightSource="{Binding RightDiff}" IsSplit="{Binding SplitDiff}"/></Grid></TabItem>
            <TabItem Header="{Binding L[PatchSelections]}"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="0,8,0,0"><TextBlock Text="{Binding L[PatchHint]}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><ListBox Grid.Row="1" ItemsSource="{Binding PatchRows}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:PatchSelection"><CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11"/></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Grid.Row="2"><vm:ActionButton Icon="Plus" Content="{Binding L[StagePatch]}" Command="{Binding ActionCommand}" CommandParameter="StagePatch" IsEnabled="{Binding CanApplyPatch}" Margin="0,0,6,6"/><vm:ActionButton Icon="Minus" Content="{Binding L[UnstagePatch]}" Command="{Binding ActionCommand}" CommandParameter="UnstagePatch" IsEnabled="{Binding CanApplyPatch}"/></WrapPanel></Grid></TabItem>
            <TabItem Header="{Binding L[CommitDetails]}"><Grid RowDefinitions="*,*" RowSpacing="12" Margin="0,8,0,0"><TextBox AutomationProperties.Name="{Binding L[CommitDetails]}" Text="{Binding CommitDetails,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/><ListBox Grid.Row="1" Name="CommitFilesList" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}"><ListBox.ItemTemplate><DataTemplate x:DataType="core:FileChange"><TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
            <TabItem Header="{Binding L[ConflictEditor]}" IsVisible="{Binding HasConflict}">
              <Grid RowDefinitions="Auto,Auto,*,Auto,*,Auto" RowSpacing="8" Margin="0,8,0,0">
                <TextBlock Text="{Binding L[ConflictHelp]}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Grid.Row="1" IsVisible="{Binding ConflictBinary}" Spacing="8"><TextBlock Text="{Binding L[BinaryConflict]}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/><WrapPanel><vm:ActionButton Icon="Branch" Content="{Binding L[Ours]}" Command="{Binding ActionCommand}" CommandParameter="ResolveOurs" Margin="0,0,6,0"/><vm:ActionButton Icon="Branch" Content="{Binding L[Theirs]}" Command="{Binding ActionCommand}" CommandParameter="ResolveTheirs"/></WrapPanel></StackPanel>
                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6" IsVisible="{Binding !ConflictBinary}" MinHeight="130">
                  <Grid RowDefinitions="Auto,*" RowSpacing="5"><TextBlock Text="{Binding L[ConflictBaseLabel]}" Classes="section"/><vm:CodeEditor Grid.Row="1" AccessibleName="{Binding L[ConflictBaseLabel]}" CodeText="{Binding ConflictBase,Mode=OneWay}"/></Grid>
                  <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="5"><TextBlock Text="{Binding L[ConflictOursLabel]}" Classes="section"/><vm:CodeEditor Grid.Row="1" AccessibleName="{Binding L[ConflictOursLabel]}" CodeText="{Binding ConflictOurs,Mode=OneWay}"/></Grid>
                  <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="5"><TextBlock Text="{Binding L[ConflictTheirsLabel]}" Classes="section"/><vm:CodeEditor Grid.Row="1" AccessibleName="{Binding L[ConflictTheirsLabel]}" CodeText="{Binding ConflictTheirs,Mode=OneWay}"/></Grid>
                </Grid>
                <StackPanel Grid.Row="3" Spacing="6" IsVisible="{Binding !ConflictBinary}">
                  <WrapPanel><vm:ActionButton Icon="Branch" Content="{Binding L[UseOursFile]}" IsEnabled="{Binding CanSaveConflict}" Command="{Binding UseConflictSideCommand}" CommandParameter="Ours" Margin="0,0,4,4"/><vm:ActionButton Icon="Branch" Content="{Binding L[UseTheirsFile]}" IsEnabled="{Binding CanSaveConflict}" Command="{Binding UseConflictSideCommand}" CommandParameter="Theirs" Margin="0,0,4,4"/><vm:ActionButton Icon="Merge" Content="{Binding L[UseBothFile]}" IsEnabled="{Binding CanSaveConflict}" Command="{Binding UseConflictSideCommand}" CommandParameter="Both" Margin="0,0,4,4"/></WrapPanel>
                  <TextBlock Text="{Binding L[SelectConflictSection]}" Classes="section"/>
                  <ComboBox ItemsSource="{Binding ConflictSections}" SelectedItem="{Binding SelectedConflictSection}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="core:ConflictSection"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <WrapPanel><vm:ActionButton Icon="Branch" Content="{Binding L[SectionOurs]}" IsEnabled="{Binding CanSaveConflict}" Command="{Binding UseConflictSectionCommand}" CommandParameter="Ours" Margin="0,0,4,4"/><vm:ActionButton Icon="Branch" Content="{Binding L[SectionTheirs]}" IsEnabled="{Binding CanSaveConflict}" Command="{Binding UseConflictSectionCommand}" CommandParameter="Theirs" Margin="0,0,4,4"/><vm:ActionButton Icon="Merge" Content="{Binding L[SectionBoth]}" IsEnabled="{Binding CanSaveConflict}" Command="{Binding UseConflictSectionCommand}" CommandParameter="Both" Margin="0,0,4,4"/></WrapPanel>
                  <TextBlock Text="{Binding L[EditableResult]}" Classes="section"/>
                </StackPanel>
                <vm:CodeEditor Grid.Row="4" Name="ConflictResultInput" AccessibleName="{Binding L[SaveConflict]}" IsEnabled="{Binding CanSaveConflict}" IsVisible="{Binding !ConflictBinary}" CodeText="{Binding ConflictResult,Mode=TwoWay}" IsReadOnly="False" MinHeight="120"/>
                <WrapPanel Grid.Row="5"><vm:ActionButton Icon="Save" Classes="primary" Content="{Binding L[SaveConflict]}" Command="{Binding ActionCommand}" CommandParameter="WriteConflictResult" IsEnabled="{Binding CanSaveConflict}" Margin="0,0,6,4"/><vm:ActionButton Icon="Check" Content="{Binding L[MarkResolved]}" Command="{Binding ActionCommand}" CommandParameter="MarkResolved" IsEnabled="{Binding CanOperate}" Margin="0,0,6,4"/><vm:ActionButton Icon="Open" Content="{Binding L[MergeTool]}" Command="{Binding ActionCommand}" CommandParameter="ExternalMergeTool" IsEnabled="{Binding CanOperate}"/></WrapPanel>
              </Grid>
            </TabItem>
            <TabItem Header="{Binding L[ImagePreview]}" IsVisible="{Binding HasImages}">
              <ScrollViewer Margin="0,8,0,0"><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="8"><TextBlock Text="{Binding L[Before]}" Classes="section"/><vm:PreviewImage AccessibleName="{Binding L[ImageBefore]}" Bytes="{Binding BeforeImage}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding L[After]}" Classes="section"/><vm:PreviewImage AccessibleName="{Binding L[ImageAfter]}" Bytes="{Binding AfterImage}"/></StackPanel></Grid></ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Classes="panel" Padding="10,6"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><StackPanel Spacing="5"><vm:OperationFeedbackBar Feedback="{Binding Feedback}"/><ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="{Binding !HasProgressPercent}" Value="{Binding ProgressPercent}" Height="3"/><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding ProgressText}" IsVisible="{Binding IsBusy}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel><vm:ActionButton Icon="Close" Grid.Column="1" Content="{Binding L[Cancel]}" IsVisible="{Binding CanCancel}" Command="{Binding CancelCommand}"/><vm:ActionButton Icon="Settings" Grid.Column="2" Name="ShortcutSettingsButton" Content="{Binding L[Shortcuts]}" Click="ShortcutSettingsClick"/><vm:ActionButton Icon="Refresh" Grid.Column="3" Content="{Binding L[Refresh]}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/></Grid></Border>
    <Expander Grid.Row="4" Name="MainOperationPanel" Header="{Binding L[OperationPanel]}" MaxHeight="220"><Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="8"><vm:ActionButton Icon="Copy" Content="{Binding L[Copy]}" Click="CopyCommandsClick" HorizontalAlignment="Right"/><TextBox Grid.Row="1" Name="CommandOutput" AutomationProperties.Name="{Binding L[OperationPanel]}" Text="{Binding Commands,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11" MinHeight="100" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></Expander>
  </Grid>
</Window>
